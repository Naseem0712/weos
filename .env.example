# Copy to .env for local overrides (optional). Railway sets these in the dashboard.

# Bind (Railway injects PORT automatically)
# PORT=8000
# WEOS_HOST=0.0.0.0
# WEOS_PORT=8000

# Writable data (projects, output). On Railway, point at a mounted volume.
# WEOS_DATA_DIR=/data
# WEOS_PROJECTS_DIR=/data/projects
# WEOS_OUTPUT_DIR=/data/output

# Optional overrides
# WEOS_STOCK_DIR=/data/stock
# WEOS_KB_DIR=/data/knowledge_base
